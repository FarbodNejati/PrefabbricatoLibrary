#library-pane {
    height: 200px;
    min-height: 16px;
    background-color: var(--unity-colors-box-background);
}

#library-pane TabView {
    overflow: hidden;
    min-height: 96px;
}

#library-pane TabView .unity-tab-view__content-container {
}

#library-pane .unity-scroll-view {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.unity-tab-view__header-container {
    flex-grow: 1;
    justify-content: center;
    margin-top: 2px;
    margin-bottom: 2px;
}

.library-view .library-view_scan-warning {
    left: 0%;
    flex-direction: row;
    background-color: var(--unity-colors-app_toolbar-background);
    padding-top: 2px;
    padding-right: 2px;
    padding-bottom: 2px;
    padding-left: 2px;
    margin-left: 4px;
    border-top-left-radius: var(--unity-metrics-default-border_radius);
    border-top-right-radius: var(--unity-metrics-default-border_radius);
    border-bottom-right-radius: var(--unity-metrics-default-border_radius);
    border-bottom-left-radius: var(--unity-metrics-default-border_radius);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-top-color: var(--unity-colors-default-border);
    overflow: visible;
}

.library-view ToolbarSearchField {
    width: auto;
    margin-right: 4px;
    margin-left: 4px;
}

.library-view .prefab-tag {
    margin-right: 2px;
    margin-top: 2px;
    margin-left: 2px;
    border-radius: var(--unity-metrics-default-border_radius);
    border-width: 1px;
    font-size: var(--unity-metrics-default-font_semi_small_size);
    -unity-text-align: middle-center;
    align-items: center;
    margin-bottom: 2px;
    flex-grow: 0;
    flex-direction: row;
    height: var(--unity-metrics-single_line-height);
    justify-content: space-between;
}

.library-view .prefab-tag:enabled:hover {
    border-color: rgba(255, 255, 255, 0.2);
}

.library-view .prefab-tag > Label {
    padding-left: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 1;
    padding-right: 4px;
}
